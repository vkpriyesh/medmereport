{
  "name": "medmereport-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "gen:api": "cd ../engine && uv run medmereport openapi --out ../web/openapi.json && cd ../web && openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/three": "^0.170.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.28.1",
    "svelte-check": "^4.7.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "three": "^0.170.0"
  }
}
