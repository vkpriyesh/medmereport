 "components": {
  "schemas": {
   "Capabilities": {
    "properties": {
     "version": {
      "type": "string",
      "title": "Version"
     },
     "python": {
      "type": "string",
      "title": "Python"
     },
     "platform": {
      "type": "string",
      "title": "Platform"
     },
     "onnxruntime": {
      "type": "boolean",
      "title": "Onnxruntime"
     },
     "totalsegmentator": {
      "type": "boolean",
      "title": "Totalsegmentator"
     },
     "offline": {
      "type": "boolean",
      "title": "Offline",
      "default": true
     }
    },
    "type": "object",
    "required": [
     "version",
     "python",
     "platform",
     "onnxruntime",
     "totalsegmentator"
    ],
    "title": "Capabilities"
   },
   "DemoJobIn": {
    "properties": {
     "steps": {
      "type": "integer",
      "title": "Steps",
      "default": 3
     },
     "delay": {
      "type": "number",
      "title": "Delay",
      "default": 0.2
     },
     "fail": {
      "type": "boolean",
      "title": "Fail",
      "default": false
     }
    },
    "type": "object",
    "title": "DemoJobIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Health": {
    "properties": {
     "ok": {
      "type": "boolean",
      "title": "Ok"
     },
     "version": {
      "type": "string",
      "title": "Version"
     }
    },
    "type": "object",
    "required": [
     "ok",
     "version"
    ],
    "title": "Health"
   },
   "JobInfo": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "kind": {
      "type": "string",
      "title": "Kind"
     },
     "status": {
      "$ref": "#/components/schemas/JobStatus"
     },
     "stage": {
      "type": "string",
      "title": "Stage",
      "default": ""
     },
     "pct": {
      "type": "number",
      "title": "Pct",
      "default": 0
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     },
     "result": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Result"
     },
     "created": {
      "type": "string",
      "format": "date-time",
      "title": "Created"
     },
     "ended": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Ended"
     }
    },
    "type": "object",
    "required": [
     "id",
     "kind",
     "status",
     "created"
    ],
    "title": "JobInfo"
   },
   "JobStatus": {
    "type": "string",
    "enum": [
     "queued",
     "running",
     "done",
     "failed",
     "cancelled"
    ],
    "title": "JobStatus"
   },
   "ProgressEvent": {
    "properties": {
     "seq": {
      "type": "integer",
      "title": "Seq"
     },
     "stage": {
      "type": "string",
      "title": "Stage"
     },
     "pct": {
      "type": "number",
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Pct"
     },
     "msg": {
      "type": "string",
      "title": "Msg",
      "default": ""
     },
     "level": {
      "type": "string",
      "enum": [
       "info",
       "warn",
       "error"
      ],
      "title": "Level",
      "default": "info"
     },
     "ts": {
      "type": "number",
      "title": "Ts"
     }
    },
    "type": "object",
    "required": [
     "seq",
     "stage",
     "pct",
     "ts"
    ],
    "title": "ProgressEvent"
   },
   "SessionIn": {
    "properties": {
     "token": {
      "type": "string",
      "title": "Token"
     }
    },
    "type": "object",
    "required": [
     "token"
    ],
    "title": "SessionIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}